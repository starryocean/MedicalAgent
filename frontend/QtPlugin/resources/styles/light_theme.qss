/* ================================================================
 * Qt Creator default-style light theme for Translation Agent
 * ----------------------------------------------------------------
 * Maps every selector from dark_theme.qss to equivalent light colors.
 * Qt Creator palette: #EFF0F1 background, #232629 text, #C8C8C8 borders
 * ================================================================ */

/* ── Global ─────────────────────────────────────────────────────── */

QWidget {
    background-color: #EFF0F1;
    color: #232629;
    font-family: "Segoe UI", "SF Pro Text", sans-serif;
}

QToolTip {
    background: #F0F0F0;
    color: #232629;
    border: 1px solid #C8C8C8;
    padding: 4px 8px;
    border-radius: 3px;
}

/* ── MainWindow ─────────────────────────────────────────────────── */

QMainWindow {
    background: #F0F0F0;
}

/* ── MenuBar & Menu ─────────────────────────────────────────────── */

QMenuBar {
    background: #E0E1E3;
    color: #232629;
    border-bottom: 1px solid #C8C8C8;
}
QMenuBar::item:selected {
    background: #D0D1D3;
}

QMenu {
    background: #F0F0F0;
    color: #232629;
    border: 1px solid #C8C8C8;
}
QMenu::item:selected {
    background: #2563EB;
    color: white;
}

/* ── StatusBar ──────────────────────────────────────────────────── */

QStatusBar {
    background: #E0E1E3;
    color: #555555;
    font-size: 11px;
}
QStatusBar[role="error"] {
    color: #D32F2F;
}

/* ── Splitter ───────────────────────────────────────────────────── */

QSplitter::handle {
    background: #C8C8C8;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* ── ScrollArea ─────────────────────────────────────────────────── */

QScrollArea {
    border: none;
    background: #F0F0F0;
}

/* ── ScrollBar ──────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: #EFF0F1;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #C8C8C8;
    border-radius: 4px;
    min-height: 20px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover { background: #A0A0A0; }
QScrollBar::handle:vertical:pressed { background: #787878; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: #EFF0F1;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #C8C8C8;
    border-radius: 4px;
    min-width: 20px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover { background: #A0A0A0; }
QScrollBar::handle:horizontal:pressed { background: #787878; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: none; }

/* ── ChatWidget ─────────────────────────────────────────────────── */

#messagesContainer {
    background: #F0F0F0;
}

/* Loading label */
#loadingLabel {
    color: #2563EB;
    font-size: 12px;
    padding: 4px 12px;
    background: #E0E1E3;
}

/* Input frame */
#inputFrame {
    background: #E0E1E3;
    border-top: 1px solid #C8C8C8;
}

/* Input text edit */
#inputEdit {
    background: white;
    color: #232629;
    border-radius: 6px;
    padding: 6px 10px;
    border: 1px solid #C8C8C8;
    font-size: 13px;
}
#inputEdit:focus {
    border-color: #2563EB;
}

/* Send button */
#sendButton {
    background: #2563EB;
    color: white;
    border-radius: 17px;
    font-size: 16px;
    font-weight: bold;
    border: none;
}
#sendButton:hover {
    background: #1D4ED8;
}
#sendButton:pressed {
    background: #1E40AF;
}
#sendButton:disabled {
    background: #C8C8C8;
}

/* ── Message Bubbles ─────────────────────────────────────────────── */

QLabel[role="user"] {
    background: #2563EB;
    color: white;
    border-radius: 12px;
    padding: 8px 12px;
    max-width: 480px;
}

QLabel[role="assistant"] {
    background: white;
    color: #232629;
    border-radius: 12px;
    padding: 8px 12px;
    max-width: 480px;
    border: 1px solid #D0D1D3;
}

/* Timestamp in message bubble */
#timestampLabel {
    color: #999999;
    font-size: 10px;
}

/* Context hint label (file selection indicator) */
#contextHint {
    color: #2563EB;
    font-size: 11px;
    padding: 3px 8px;
    background: #E0E1E3;
    border-radius: 4px;
    border: 1px solid #C8C8C8;
}

/* ── DiffViewer ─────────────────────────────────────────────────── */

/* Header */
#diffHeader {
    background: #E0E1E3;
    color: #232629;
    font-weight: bold;
    font-size: 13px;
    padding: 8px 12px;
    border-bottom: 1px solid #C8C8C8;
}

/* Stats bar */
#statsLabel {
    background: #EFF0F1;
    color: #555555;
    font-size: 12px;
    padding: 4px 12px;
    border-bottom: 1px solid #C8C8C8;
}

/* Summary/diff text edits */
#summaryEdit {
    background: white;
    color: #232629;
    border: none;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 12px;
}

#diffEdit {
    background: #F5F5F5;
    color: #232629;
    border: none;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
}

/* Button bar */
#buttonBar {
    background: #E0E1E3;
    border-top: 1px solid #C8C8C8;
}

/* Reject button */
#rejectButton {
    background: #C8C8C8;
    color: #232629;
    border-radius: 6px;
    padding: 7px 18px;
    font-size: 13px;
    border: none;
}
#rejectButton:hover {
    background: #A0A0A0;
}

/* Accept button */
#acceptButton {
    background: #2E7D32;
    color: white;
    border-radius: 6px;
    padding: 7px 18px;
    font-size: 13px;
    border: none;
    font-weight: bold;
}
#acceptButton:hover {
    background: #388E3C;
}

/* ── FileExplorer ────────────────────────────────────────────────── */

#filterEdit {
    background: white;
    color: #232629;
    border: 1px solid #C8C8C8;
    padding: 6px 10px;
    font-size: 12px;
}
#filterEdit:focus {
    border-bottom: 2px solid #2563EB;
}

#fileTree {
    background: white;
    color: #232629;
    border: none;
    font-size: 12px;
}
#fileTree::item:hover {
    background: #E0E1E3;
}
#fileTree::item:selected {
    background: #2563EB;
    color: white;
}

/* ── TextEditor ─────────────────────────────────────────────────── */

QPlainTextEdit {
    background: white;
    color: #232629;
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 13px;
    border: 1px solid #D0D1D3;
    selection-background-color: #BBDEFB;
}

/* Line number area background is painted via QPainter in C++ */
